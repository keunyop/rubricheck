    "validate:scoring": "node --import ./scripts/register-test-resolver.mjs --experimental-strip-types scripts/validate_scoring.ts",
    "test:all": "node scripts/run_all_tests.mjs",
    "test:recovery:browser": "node scripts/check_evaluation_recovery.mjs",
    "test:trial:browser": "node scripts/check_guest_trial.mjs",
